<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_50"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/posdes" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/archivo"
        android:text="Verifikasi OTP"
        android:textColor="@color/teal_700"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvInfoNoHp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:fontFamily="@font/archivo"
        android:gravity="center"
        android:text="Masukkan kode OTP yang dikirim ke nomor Anda"
        android:textColor="@color/gray_500"
        android:textSize="14sp" />

    <!-- OTP Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <EditText
            android:id="@+id/etOtp1"
            android:layout_width="50dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:background="@drawable/otp_background"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/gray_900"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOtp2"
            android:layout_width="50dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:background="@drawable/otp_background"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/gray_900"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOtp3"
            android:layout_width="50dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:background="@drawable/otp_background"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/gray_900"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOtp4"
            android:layout_width="50dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:background="@drawable/otp_background"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/gray_900"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOtp5"
            android:layout_width="50dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:background="@drawable/otp_background"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/gray_900"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOtp6"
            android:layout_width="50dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:background="@drawable/otp_background"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/gray_900"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Button Verifikasi -->
    <Button
        android:id="@+id/btnVerify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/green_500"
        android:text="Verifikasi"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <!-- Timer dan Resend -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tidak menerima kode? "
            android:textColor="@color/gray_500"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="Kirim Ulang"
            android:textColor="@color/teal_700"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="00:30"
        android:textColor="@color/gray_500"
        android:textSize="14sp" />

</LinearLayout>