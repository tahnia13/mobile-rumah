<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Rounded Header matching logo shape -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_rounded_bottom"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="30dp"
            android:paddingHorizontal="16dp"
            android:gravity="center">

            <androidx.cardview.widget.CardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardCornerRadius="40dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">
                <ImageView
                    android:id="@+id/ivItemIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/posdes"
                    android:padding="2dp"
                    android:scaleType="centerCrop" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="John Doe"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvSubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subtitle Info"
                android:textColor="#D1FAE5"
                android:textSize="13sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/badge_background"
                android:backgroundTint="#FFFFFF"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:text="ACTIVE"
                android:textColor="#059669"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Information Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDetail1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="12dp"
                android:text="Detail information 1"
                android:textColor="#4B5563"
                android:textSize="13sp"
                app:drawableStartCompat="@android:drawable/ic_menu_my_calendar"
                app:drawableTint="#10B981" />

            <TextView
                android:id="@+id/tvDetail2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:drawablePadding="12dp"
                android:text="Detail information 2"
                android:textColor="#4B5563"
                android:textSize="13sp"
                app:drawableStartCompat="@android:drawable/ic_menu_info_details"
                app:drawableTint="#10B981" />

            <TextView
                android:id="@+id/tvDetail3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:drawablePadding="12dp"
                android:text="Detail information 3"
                android:textColor="#4B5563"
                android:textSize="13sp"
                app:drawableStartCompat="@android:drawable/ic_menu_edit"
                app:drawableTint="#10B981" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>